# MacOS
.DS_Store

# Vim
*.swp
*.swo

# Logs
*.log

# Tmux plugins
tmux/.config/tmux/plugins

# Secrets
.env

# Wakatime
wakatime/.wakatime.cfg

# Temporary files
tmp/
.cache/

# Nvim: Omarchy-generated theme symlink (points into per-machine omarchy state)
nvim/.config/nvim/lua/plugins/theme.lua

# Herdr runtime
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json

# Opencode: herdr plugin runtime (regenerated on first herdr use)
opencode/.config/opencode/node_modules
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/.gitignore
opencode/.config/opencode/*.bak

# Omarchy shell plugin: live checkout managed by `omarchy plugin add`/`omarchy plugin update`
omarchy/.config/omarchy/plugins/io.github.joshz7.afterglow/
omarchy/.config/omarchy/plugins/mrpbennett.sesh/
omarchy/.config/omarchy/plugins/vbrosseau.alttab/
omarchy/.config/omarchy/plugins/techywilbur.pomodoro/
omarchy/.config/omarchy/plugins/io.github.argusguardian.freemodels/
omarchy/.config/omarchy/plugins/.gr4vty.menu.bak.20260909084528/
