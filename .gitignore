# MacOS
.DS_Store

# Vim
*.swp
*.swo

# Logs
*.log

# Tmux plugins
tmux/.config/tmux/plugins

# Secrets
.env

# Wakatime
wakatime/.wakatime.cfg

# Temporary files
tmp/
.cache/

# Nvim: Omarchy-generated theme symlink (points into per-machine omarchy state)
nvim/.config/nvim/lua/plugins/theme.lua

# Herdr runtime
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/release-notes.json

# Ghostty: per-OS merged config, regenerated by bin/merge-ghostty-config.sh
ghostty/.config/ghostty/config.ghostty

# Opencode: herdr plugin runtime (regenerated on first herdr use)
opencode/.config/opencode/node_modules
opencode/.config/opencode/package.json
opencode/.config/opencode/package-lock.json
opencode/.config/opencode/.gitignore
opencode/.config/opencode/*.bak
opencode/.config/opencode/plugins/
opencode/.config/opencode/herdr-opencode/
opencode/.config/opencode/herdr-tui-session.js

# Omarchy shell plugin: live checkout managed by `omarchy plugin add`/`omarchy plugin update`
omarchy/.config/omarchy/plugins/io.github.joshz7.afterglow/
omarchy/.config/omarchy/plugins/techywilbur.pomodoro/
omarchy/.config/omarchy/plugins/io.github.codesmith28.omalt-tab/
omarchy/.config/omarchy/plugins/io.github.smoothpixels.cursor-accent/
# Written by that plugin's tools/install-cursor-hook.sh, and bakes in a
# per-machine plugin path, so it is generated rather than shared.
omarchy/.config/omarchy/hooks/*/cursor-accent.sh
omarchy/.config/omarchy/plugins/thefreshoffice.speaker-calibrator/
omarchy/.config/omarchy/plugins/io.github.ehlxr.advanced-workspaces/
omarchy/.config/omarchy/plugins/njpatel.omapager/
