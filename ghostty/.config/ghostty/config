# Options or the bound key (default: Command + Shift + comma on macOS and Control + Shift + comma on other platforms).

# Shared macOS/Linux config. macOS uses the Adventure fallback below.

# On Omarchy/Linux, the generated palette overrides it (missing file is silently
# skipped, thanks to the leading `?`).

# OS-specific settings (macos.conf / linux.conf) are merged into the generated
# ~/.config/ghostty/config.ghostty by bin/merge-ghostty-config.sh, which loads
# before this file. Re-run that script after editing this file conf or the
# platform confs. Keys set here win over the generated file.

theme = Adventure
config-file = ?~/.local/state/omarchy/current/theme/ghostty.conf
clipboard-read = allow
clipboard-write = allow
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
font-family = "JetBrainsMono Nerd Font"
bell-features = title, no-attention
quick-terminal-position = top
quick-terminal-size = 65%
quick-terminal-space-behavior = remain
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
confirm-close-surface = false

custom-shader = ~/Dotfiles/ghostty/.config/ghostty/shaders/cursor_warp.glsl
custom-shader-animation = always
