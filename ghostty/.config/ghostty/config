# Options or the bound key (default: Command + Shift + comma on macOS and Control + Shift + comma on other platforms).

# Shared macOS/Linux config. macOS uses the Adventure fallback below.

# On Omarchy/Linux, the generated palette overrides it (missing file is silently skipped, thanks to the leading `?`).

theme = Adventure
config-file = ?~/.local/state/omarchy/current/theme/ghostty.conf
config-file = ?~/.config/ghostty/macos.conf
clipboard-read = allow
clipboard-write = allow
shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = true
font-size = 10
font-family = "FiraCode Nerd Font"
bell-features = title, no-attention
quick-terminal-position = top
quick-terminal-size = 65%
quick-terminal-space-behavior = remain
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

