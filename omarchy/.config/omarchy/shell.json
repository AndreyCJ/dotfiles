{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.keyboard-layout"
        }
      ],
      "left": [
        {
          "id": "omarchy.media"
        },
        {
          "id": "io.github.ehlxr.advanced-workspaces"
        },
        {
          "colorMode": "bonfire",
          "id": "io.github.joshz7.afterglow",
          "showNextButton": true,
          "sparkIntensity": "full",
          "spectrumBars": 28
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "hidden": [],
          "id": "omarchy.tray",
          "pinned": [
            "Happ"
          ]
        },
        {
          "id": "techywilbur.pomodoro"
        },
        {
          "id": "bit-dev.system-pills",
          "pillOpacity": 0
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "gr4vty.notifications"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.media"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "gr4vty.notifications"
    },
    {
      "id": "io.github.codesmith28.omalt-tab"
    },
    {
      "id": "io.github.smoothpixels.cursor-accent"
    }
  ],
  "version": 1
}
