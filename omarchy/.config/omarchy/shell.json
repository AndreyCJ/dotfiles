{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "colorMode": "bonfire",
          "id": "io.github.joshz7.afterglow",
          "showNextButton": true,
          "sparkIntensity": "full",
          "spectrumBars": 28
        },
        {
          "id": "tornikegomareli.spaces",
          "showApps": "all",
          "iconStyle": "color",
          "labelStyle": "number",
          "perMonitor": true,
          "previewLive": false,
          "previews": false,
          "scrollSwitch": false,
          "animations": false
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "center": [
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "njpatel.omapager",
          "edgeSpacing": 8,
          "historyHours": 24
        },
        {
          "id": "omarchy.indicators",
          "items": [
            "Dictation",
            "ScreenRecording",
            "Reminder",
            "NightLight",
            "StayAwake"
          ]
        },
        {
          "id": "omarchy.keyboard-layout"
        }
      ],
      "right": [
        {
          "id": "omarchy.agents"
        },
        {
          "hidden": [],
          "id": "omarchy.tray",
          "pinned": [
            "Happ"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.media"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "gdeyoung.powercore",
          "barExtra": "off",
          "acProfile": "balanced",
          "batteryProfile": "power-saver"
        }
      ]
    },
    "position": "top",
    "transparent": false,
    "id": "omarchy.bar"
  },
  "disabledPlugins": [
    "omarchy.media",
    "omarchy.notifications"
  ],
  "idle": {
    "lock": 600,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "io.github.smoothpixels.cursor-accent"
    },
    {
      "id": "io.github.mtolhuys.fathom"
    }
  ],
  "version": 1
}
